# Copy to .env (repo root). The backend reads it; nothing here is required to
# start: with everything empty you get public prices, paper trading and a news
# feed without AI summaries.

# --- API ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Exchange (empty = public market data + paper trading) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
PAPER_TRADING=true
PAPER_STARTING_BALANCE=10000
DEFAULT_SYMBOLS=["BTC/USDT","ETH/USDT","LTC/USDT","SOL/USDT"]

# --- Claude: agent decision review + daily news digest (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Public data APIs (all optional; keys only raise the free limits) ---
# CoinGecko Demo: https://www.coingecko.com/en/api/pricing (100 calls/min)
COINGECKO_API_KEY=
# CoinMarketCap Basic: https://coinmarketcap.com/api/ (15k credits/month)
COINMARKETCAP_API_KEY=
# Etherscan V2: https://etherscan.io/apis (one key, 50+ chains, 3 calls/s)
ETHERSCAN_API_KEY=

# --- Web3: any JSON-RPC endpoint (Infura, Alchemy, public node...) ---
WEB3_RPC_URL=

# --- News bot ---
NEWS_AUTO_REFRESH=false
NEWS_REFRESH_MINUTES=60

# --- Auth ---
# At least 32 random bytes. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-32-random-bytes-for-prod
JWT_EXPIRE_MINUTES=1440
# Registering with one of these emails makes the account an admin.
ADMIN_EMAILS=["you@example.com"]
# false = accounts work without confirming the email (handy without a mail provider)
REQUIRE_EMAIL_VERIFICATION=true
# Base URL of the frontend, used in the links inside emails
FRONTEND_URL=http://localhost:5173

# --- Social login (optional: a provider shows in the menu only with both values set) ---
# Where the browser can reach this API; the provider sends the user back to
# {PUBLIC_API_URL}/api/auth/oauth/{google|github|microsoft}/callback (register that URI at each provider)
PUBLIC_API_URL=http://127.0.0.1:8000
# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Microsoft: https://entra.microsoft.com (App registrations, Web platform). "common" = personal + work accounts
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Sign-In with Ethereum (no keys). The domain the wallet shows; empty = host of FRONTEND_URL
SIWE_DOMAIN=

# --- On-chain: Base Sepolia (testnet). Addresses come from the deploy in contracts/README.md
CHAIN_ID=84532
TOKEN_ADDRESS=
BADGE_ADDRESS=
# The backend wallet holding MINTER_ROLE. Testnet only; never a wallet with real funds.
MINTER_PRIVATE_KEY=

# --- Database (empty = SQLite in backend/data/). For Postgres (Neon, Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=

# --- Email: console (prints the link in the backend log) | resend | smtp ---
EMAIL_BACKEND=console
EMAIL_FROM="MonsterBroker <onboarding@resend.dev>"
# Resend (https://resend.com, free 100/day). A noreply@your-domain sender needs the domain verified there.
RESEND_API_KEY=
# SMTP (Brevo free 300/day: smtp-relay.brevo.com:587, or any other relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
