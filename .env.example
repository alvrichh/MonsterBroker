# Copy to .env (repo root). The backend reads it; nothing here is required to
# start: with everything empty you get public prices, paper trading and a news
# feed without AI summaries.

# --- API ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Exchange (empty = public market data + paper trading) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
PAPER_TRADING=true
PAPER_STARTING_BALANCE=10000
DEFAULT_SYMBOLS=["BTC/USDT","ETH/USDT","LTC/USDT","SOL/USDT"]

# --- Claude: agent decision review + daily news digest (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Public data APIs (all optional; keys only raise the free limits) ---
# CoinGecko Demo: https://www.coingecko.com/en/api/pricing (100 calls/min)
COINGECKO_API_KEY=
# CoinMarketCap Basic: https://coinmarketcap.com/api/ (15k credits/month)
COINMARKETCAP_API_KEY=
# Etherscan V2: https://etherscan.io/apis (one key, 50+ chains, 3 calls/s)
ETHERSCAN_API_KEY=

# --- Web3: any JSON-RPC endpoint (Infura, Alchemy, public node...) ---
WEB3_RPC_URL=

# --- News bot ---
NEWS_AUTO_REFRESH=false
NEWS_REFRESH_MINUTES=60

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
